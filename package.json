{
  "name": "yousub",
  "version": "0.2.5",
  "description": "Real-time AI subtitle translator for YouTube (BYOK, multi-provider LLM)",
  "type": "module",
  "private": true,
  "author": "Masaru",
  "license": "AGPL-3.0-only",
  "keywords": [
    "youtube",
    "subtitles",
    "translation",
    "chrome-extension",
    "firefox-extension",
    "manifest-v3",
    "llm",
    "byok"
  ],
  "engines": {
    "node": ">=20"
  },
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:log": "node scripts/test-log.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "node scripts/package.js all",
    "package:chrome": "node scripts/package.js chrome",
    "package:firefox": "node scripts/package.js firefox",
    "publish:chrome": "node scripts/publish.js --target=chrome",
    "publish:firefox": "node scripts/publish.js --target=firefox",
    "publish:stores": "node scripts/publish.js --target=all",
    "publish:dry-run": "node scripts/publish.js --target=all --dry-run",
    "verify": "npm run lint && npm run format:check && npm run test:log && npm run package",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,cjs,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@jest/globals": "^30.5.2",
    "adm-zip": "^0.6.1",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^16.4.0",
    "prettier": "^3.10.1"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "overrides": {
    "ws": "^8.21.0",
    "glob@>=9.0.0": "^14.0.6",
    "minimatch@>=7.0.0": "^11.0.9"
  }
}
