# Store Automation Credentials (copy needed values into `.env` — never commit real secrets)

# Chrome Web Store API v2 (https://developer.chrome.com/docs/webstore/api)
# Publisher ID = the UUID at the end of https://chrome.google.com/webstore/devconsole/<UUID>
CWS_PUBLISHER_ID=
CWS_ITEM_ID=jlpgmjpekhnlncfdkmddoienleiljehk

# Option A (Recommended - simplest, never expires): Google Cloud Service Account JSON key
# Save the downloaded JSON inside gitignored `tmp/cws-key.json` and link its email under Developer Console -> Account
CWS_SERVICE_ACCOUNT_PATH=
# (For GitHub Actions Secrets, store the raw JSON content in CWS_SERVICE_ACCOUNT_JSON instead)
# CWS_SERVICE_ACCOUNT_JSON=

# Option B: Traditional OAuth 2.0 credentials
CWS_CLIENT_ID=
CWS_CLIENT_SECRET=
CWS_REFRESH_TOKEN=

# Firefox Add-ons (AMO) API v5 (https://addons.mozilla.org/en-US/developers/addon/api/key/)
AMO_JWT_ISSUER=
AMO_JWT_SECRET=
